{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "egrit-preflight vendor target profile, profile_version 1",
  "description": "Contract in docs/vendor-target-profile.md. A companion record, not a report: no CLI command reads it and it adds nothing to report schema_version 1. Some rules JSON Schema does not state here (a value needs a grade, a date and, when declared, a source; a null value has evidence 'none'; no unknown fact; no repeated interface) are checked by egrit_preflight.profile.check_profile and the fixtures in tests/fixtures/profiles/.",
  "type": "object",
  "required": [
    "document",
    "profile_version",
    "identity",
    "facts",
    "required_interfaces"
  ],
  "properties": {
    "document": {
      "const": "egrit-preflight vendor target profile"
    },
    "profile_version": {
      "const": "1"
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for made-up test data. A synthetic profile describes no real product."
    },
    "identity": {
      "type": "object",
      "description": "One configuration. Null means not established; a null revision makes every fact UNKNOWN.",
      "required": [
        "vendor",
        "product",
        "model",
        "module",
        "hardware_revision",
        "software_revision",
        "profile_revision"
      ],
      "properties": {
        "vendor": {
          "$ref": "#/$defs/text"
        },
        "product": {
          "$ref": "#/$defs/text"
        },
        "model": {
          "$ref": "#/$defs/text_or_null"
        },
        "module": {
          "$ref": "#/$defs/text_or_null",
          "description": "The compute module, kept apart from the product name."
        },
        "hardware_revision": {
          "$ref": "#/$defs/text_or_null"
        },
        "software_revision": {
          "$ref": "#/$defs/text_or_null",
          "description": "The vendor's software or BSP revision."
        },
        "profile_revision": {
          "$ref": "#/$defs/text",
          "description": "The revision of this record, changed whenever a statement is added, removed or edited."
        }
      }
    },
    "facts": {
      "type": "object",
      "description": "Each fact is a list of statements. An empty list means nothing is stated. Statements that disagree are all kept.",
      "required": [
        "architecture",
        "os_distribution",
        "os_build",
        "abi",
        "jetpack",
        "jetson_linux",
        "cuda",
        "tensorrt",
        "container_runtime"
      ],
      "properties": {
        "architecture": {
          "$ref": "#/$defs/statements"
        },
        "os_distribution": {
          "$ref": "#/$defs/statements"
        },
        "os_build": {
          "$ref": "#/$defs/statements"
        },
        "abi": {
          "$ref": "#/$defs/statements"
        },
        "jetpack": {
          "$ref": "#/$defs/statements"
        },
        "jetson_linux": {
          "$ref": "#/$defs/statements"
        },
        "cuda": {
          "$ref": "#/$defs/statements"
        },
        "tensorrt": {
          "$ref": "#/$defs/statements"
        },
        "container_runtime": {
          "$ref": "#/$defs/statements"
        }
      }
    },
    "required_interfaces": {
      "type": "array",
      "maxItems": 50,
      "description": "Interfaces a workload needs on the device. Each is REQUIRES_HARDWARE, whatever the profile says.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,59}$"
      }
    },
    "equivalences": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/equivalence"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "text_or_null": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 400
    },
    "evidence": {
      "enum": [
        "observed",
        "declared",
        "none"
      ]
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://",
      "maxLength": 1008
    },
    "retrieved": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The day the source was read, or the day of the observation."
    },
    "statements": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "statement": {
      "type": "object",
      "required": [
        "value",
        "evidence",
        "source_url",
        "retrieved",
        "applies_to"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/text_or_null"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "source_url": {
          "$ref": "#/$defs/source_url"
        },
        "retrieved": {
          "$ref": "#/$defs/retrieved"
        },
        "applies_to": {
          "type": "object",
          "description": "The revisions the source is about. The statement counts only when both equal the profile's identity.",
          "required": [
            "hardware_revision",
            "software_revision"
          ],
          "properties": {
            "hardware_revision": {
              "$ref": "#/$defs/text_or_null"
            },
            "software_revision": {
              "$ref": "#/$defs/text_or_null"
            }
          }
        }
      }
    },
    "equivalence": {
      "type": "object",
      "description": "A sourced statement that this configuration may be read as another for the listed facts only.",
      "required": [
        "identity",
        "fields",
        "evidence",
        "source_url",
        "retrieved"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "required": [
            "vendor",
            "product",
            "model",
            "module",
            "hardware_revision",
            "software_revision",
            "profile_revision"
          ],
          "properties": {
            "vendor": {
              "$ref": "#/$defs/text"
            },
            "product": {
              "$ref": "#/$defs/text"
            },
            "model": {
              "$ref": "#/$defs/text"
            },
            "module": {
              "$ref": "#/$defs/text"
            },
            "hardware_revision": {
              "$ref": "#/$defs/text"
            },
            "software_revision": {
              "$ref": "#/$defs/text"
            },
            "profile_revision": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "architecture",
              "os_distribution",
              "os_build",
              "abi",
              "jetpack",
              "jetson_linux",
              "cuda",
              "tensorrt",
              "container_runtime"
            ]
          }
        },
        "evidence": {
          "enum": [
            "observed",
            "declared"
          ]
        },
        "source_url": {
          "$ref": "#/$defs/source_url"
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
